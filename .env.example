# Copy to .env and fill in — .env is gitignored and never committed.
#
# Loaded into the environment before Hydra/OmegaConf composes the config, so
# `${oc.env:AGRITUNE_ENCODER_API_KEY,null}` in configs/encoder/remote.yaml resolves from here.
# Requires python-dotenv: pip install -e ".[dotenv]"
#
# Anything already exported in your shell wins over the values below.

# API key for the hosted encoder embeddings API (encoder=remote).
AGRITUNE_ENCODER_API_KEY=
